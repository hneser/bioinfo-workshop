# bioinfo-workshop: the one root action the rstudio user may take, for the organiser's
# last-resort fallback (WORKSHOP.md §5 step 11d): start RStudio with password login.
Defaults!/usr/local/share/bioinfo-workshop/start-rstudio-password.sh env_keep += "RSTUDIO_PASSWORD"
rstudio ALL=(root) NOPASSWD: /usr/local/share/bioinfo-workshop/start-rstudio-password.sh
